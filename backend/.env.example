# Porta da API (o Next.js usa 3000 por padrão)
PORT=3333

# Segredo usado para assinar os JWT (obrigatório em produção)
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio

# Tempo de vida do token, em segundos (padrão: 8 horas)
JWT_EXPIRES_IN_SECONDS=28800

# Arquivo SQLite. Use ":memory:" para um banco efêmero.
DATABASE_FILE=data/core-access.db
